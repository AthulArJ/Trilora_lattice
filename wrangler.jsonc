{
  "name": "trilora-lattice",
  "main": "./worker/index.js",
  "keep_vars": true,
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/runtime-config.js"],
    "not_found_handling": "single-page-application"
  }
}
