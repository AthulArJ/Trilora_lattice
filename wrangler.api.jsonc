{
  "name": "trilora-lattice-api",
  "main": "./worker/api.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat", "allow_eval_during_startup"],
  "workers_dev": true,
  "keep_vars": true,
  "alias": { "pino": "./node_modules/pino/pino.js" },
  "vars": {
    "NODE_ENV": "production",
    "CLOUDFLARE_WORKER": "true",
    "PORT": "4000",
    "WEB_ORIGIN": "https://lattice.trilora.net",
    "SUPABASE_URL": "https://hoqttcnmsxlbvpfritbf.supabase.co"
  },
  // Initial production rollout: no automatic telemetry queue processing.
  "triggers": { "crons": [] },
  "observability": { "enabled": true }
}
